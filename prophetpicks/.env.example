# =========================================================================
# ProphetPicks env template (server-side only — never prefix with VITE_).
# Copy to .env for `vercel dev` or paste each key into Vercel project envs.
# Everything below is OPTIONAL: the app runs in demo mode with no keys set.
# =========================================================================

# The Odds API (https://the-odds-api.com)
# Powers /api/odds and the active-feed badge on the Odds Board.
ODDS_API_KEY=

# API-Football (https://www.api-football.com)
# Used by the scripts/sync-soccer-fixtures.ts batch job.
APIFOOTBALL_KEY=

# Sportradar (https://developer.sportradar.com)
# Reserved for /api/live real-time scores when wired.
SPORTRADAR_API_KEY=

# TheSportsDB (https://www.thesportsdb.com/api.php)
# Powers /api/team-logo (real team badges) and /api/livescore (real in-play).
# The shared public test key `3` is used by default — no signup needed.
# Set this to your private key for higher rate limits.
SPORTSDB_API_KEY=

# Neon Postgres (https://neon.tech) — set automatically when you connect
# Neon through the Vercel Marketplace. Apply migrations/0001_init.sql once
# you have a connection string. /api/bets and /api/slips read this.
DATABASE_URL=
